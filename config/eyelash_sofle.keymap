#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        jk-to-Escape {
            bindings = <&kp ESC>;
            key-positions = <34 35>;
            layers = <0>;
        };
    };

    behaviors {
        td_caps_word: td_caps_word {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_CAPS_WORD";
            #binding-cells = <0>;
            bindings = <&caps_word>, <&kp CAPSLOCK>;
        };

        mt_z_pref: mod_tap_z_preferred {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        mt_slash_pref: mod_tap_slash_preferred {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        lt_layer_preferred: layout_tap_layer_preferred {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Main0 {
            label = "Qwerty";
            bindings = <
&mt ESCAPE EQUAL          &kp NUMBER_1           &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4          &kp NUMBER_5                   &trans  &kp NUMBER_6              &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0                    &kp MINUS
&td_caps_word             &kp Q                  &kp W         &kp E         &kp R                 &kp T                          &trans  &kp Y                     &kp U         &kp I         &kp O         &kp P                           &kp BACKSLASH
&mt LEFT_SHIFT BACKSPACE  &kp A                  &kp S         &kp D         &kp F                 &kp G                          &trans  &kp H                     &kp J         &kp K         &kp L         &kp SEMICOLON                   &mt RIGHT_SHIFT SINGLE_QUOTE
&kp LEFT_CONTROL          &mt_z_pref LEFT_ALT Z  &kp X         &kp C         &kp V                 &kp B                          &trans  &kp N                     &kp M         &kp COMMA     &kp PERIOD    &mt_slash_pref RIGHT_ALT SLASH  &kp RIGHT_CONTROL
&trans                    &none                  &none         &none         &mt LEFT_COMMAND TAB  &lt_layer_preferred 1 ENTER    &trans  &mt LEFT_SHIFT BACKSPACE  &lt 2 SPACE   &none         &none         &none
            >;
        };

        Hk+Num1 {
            label = "Hk+Num";
            bindings = <
&kp ESCAPE  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5    &trans  &kp F6        &kp F7        &kp F8        &kp F9     &kp F10    &kp F11
&trans      &none   &none   &none   &none   &none     &trans  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp MINUS  &kp SLASH  &kp F12
&trans      &none   &none   &none   &none   &none     &trans  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PLUS   &kp STAR   &kp BACKSPACE
&trans      &trans  &none   &none   &none   &none     &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp DOT    &kp EQUAL  &kp ENTER
&trans      &trans  &trans  &trans  &trans  &trans    &trans  &trans        &kp NUMBER_0  &trans        &trans     &trans
            >;
        };

        Sys+Nav2 {
            label = "Sys+Nav";
            bindings = <
&bt BT_CLR  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp C_PREVIOUS     &kp C_PLAY_PAUSE      &kp C_NEXT               &trans  &kp C_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &none      &none   &bt BT_CLR_ALL
&kp GRAVE   &kp EXCLAMATION       &kp AT_SIGN           &kp HASH           &kp DOLLAR            &kp PERCENT              &trans  &kp HOME    &kp PG_DN          &kp PG_UP        &kp END    &none   &none
&trans      &kp CARET             &kp AMPERSAND         &kp ASTERISK       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS    &trans  &kp LEFT    &kp DOWN           &kp UP           &kp RIGHT  &none   &kp RIGHT_SHIFT
&trans      &trans                &kp LEFT_BRACKET      &kp RIGHT_BRACKET  &kp LEFT_BRACE        &kp RIGHT_BRACE          &trans  &none       &kp LC(LS(TAB))    &kp LC(TAB)      &none      &trans  &trans
&trans      &trans                &trans                &trans             &trans                &trans                   &trans  &trans      &trans             &trans           &trans     &trans
            >;
        };
    };
};
